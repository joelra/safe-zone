{
	"schemaVersion": 1,
	"id": "safe-zone",
	"version": "${version}",
	"name": "Safe Zone",
	"description": "Server-side land-claim protection for Fabric with Golden Hoe claiming, /claim player tools, and /sz admin controls for unmodded clients.",
	"authors": [
		"SimpleForAPanda"
	],
	"license": "MIT",
	"icon": "assets/safe-zone/icon.png",
	"environment": "server",
	"entrypoints": {
		"main": [
			"com.simpleforapanda.safezone.SafeZone"
		],
		"fabric-datagen": [
			"com.simpleforapanda.safezone.datagen.SafeZoneDataGenerator"
		]
	},
	"mixins": [
		"safe-zone.mixins.json"
	],
	"depends": {
		"fabricloader": ">=${fabric_loader}",
		"minecraft": "${minecraft}",
		"java": ">=${java_min}",
		"fabric-api": ">=${fabric_api}"
	}
}
